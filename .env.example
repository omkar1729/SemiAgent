# Copy to .env and fill in. Only the two keys below are secrets.
OPENAI_API_KEY=
USPTO_API_KEY=
# SerpApi key (preferred patent source — real Google Patents abstracts): serpapi.com
SERPAPI_API_KEY=

# Optional: enables the BigQuery (Google Patents) corpus source with real
# abstracts. Requires `pip install google-cloud-bigquery db-dtypes` and
# Application Default Credentials (`gcloud auth application-default login`).
GCP_PROJECT=

# --- optional overrides (defaults live in config.py) ---
# USE_TRAINED_VIT=false
# LLM_MODEL=gpt-4o-mini
# DEVICE=auto                 # auto -> cuda if available, else cpu
# CORPUS_MAX_DOCS=1000
# VIT_BATCH_SIZE=32
# VIT_EPOCHS=20
# VIT_MAX_TRAIN_SAMPLES=0     # 0 = full split; set e.g. 3000 for a quick run

# --- SemiKong diagnosis backend (for ablation condition E) ---
# SEMIKONG_BACKEND=semikong_local   # in-process transformers+bitsandbytes 4-bit
#   ... or "semikong" for an OpenAI-compatible server:
# SEMIKONG_BASE_URL=http://localhost:1234/v1
# SEMIKONG_MODEL=semikong
# SEMIKONG_HF_MODEL=pentagoniac/SEMIKONG-8B-chat   # gated model -> needs HF_TOKEN
# HF_TOKEN=                                          # token with access to the model
